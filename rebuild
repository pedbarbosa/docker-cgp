#!/usr/bin/env bash
# Builds and tests the Python image locally as 'pedbarbosa/cgp:python'.
#
# On this branch the image is published by the 'Publish python image'
# workflow on every push, not from here: docker-image-refresh would tag
# the Python image 'latest'. With --compare, also compares it with the PHP
# CGP (pedbarbosa/cgp:dev).
set -euo pipefail

cd "$(dirname "$0")"
IMAGE=pedbarbosa/cgp:python

docker build --platform linux/amd64 --pull \
    --build-arg REVISION="$(git rev-parse HEAD)" \
    --tag "$IMAGE" .
./test "$IMAGE"
if [ "${1:-}" = --compare ]; then
    tests/compare-with-php "$IMAGE"
fi
echo "Built and tested '$IMAGE'. Push to the 'python' branch to publish it."
